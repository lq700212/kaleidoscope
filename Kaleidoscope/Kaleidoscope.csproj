    <Compile Include="Services\KeyenceScannerReader.cs" />
    <!-- 授权体系（V0.9.56 自 HuaJiVision.Core.Security 下沉：ECDsa 激活门禁，见各文件头注释） -->
    <Compile Include="Security\LicenseCodec.cs" />
    <Compile Include="Security\LicenseGate.cs" />
    <Compile Include="Security\LicenseBridges.cs" />
    <Compile Include="Security\LicenseStateIni.cs" />
    <!-- 业务流编排（Flowing，V1.9.0）：宿主业务流调度器下沉——多组常驻轮询线程统一管理
         （专属命名线程/防重入/独占资源冲突 fail-fast/异常隔离节流/健康报告），见文件头注释 -->
    <Compile Include="Flowing\FlowGroupRunner.cs" />
    <!-- 业务流编排（Flowing，V1.10.0）：状态机引擎原语沉库——发号三件套泛型化/快照-边沿顺序契约/
         期望值去重补写执行器/每拍现取政策源（宿主 V0.9.66 反哺；对齐 HJVision LineFlow 与
         CureLine IoBus 血泪契约），见各文件头注释 -->
    <Compile Include="Flowing\EntityTracker.cs" />
    <Compile Include="Flowing\SignalSource.cs" />
    <Compile Include="Flowing\EffectSink.cs" />
    <Compile Include="Flowing\PolicySource.cs" />
    <!-- 数据落库引擎（Stores，V1.12.0）：SQLite 单写线程落库底座沉库——单写线程/批量事务/
         WAL/坏库自愈/积压保险丝/独立短连接读/DbMeta kv/旧库补列迁移/增量空间回收，
         业务只注入表结构 SQL 与委托型写动作（宿主 V0.9.68 反哺；逻辑一比一对齐
         HJVision SqliteRecordQue 骨架与全部血泪注释），见文件头注释 -->
    <Compile Include="Stores\KxSqliteStore.cs" />
    <Compile Include="Stores\KxDbAction.cs" />
    <!-- 工业相机层（Cameras，V1.12.0）：三品牌采集底座沉库——中性帧 KxCamFrame（解 ICogImage
         焊点）/抽象基类/三品牌发现/GigE 改 IP 执行体/大恒+海康2D+海康3D 适配器（全部真机
         血泪注释随行：Init 配对计数/深拷防花屏/EnsureMono8 验真/Stride 感知/复位生效链等）；
         宿主桥负责 KxCamFrame→自家图像容器（VisionPro 侧留宿主，库零 VisionPro 依赖），
         见各文件头注释 -->
    <Compile Include="Cameras\KxCamTypes.cs" />
    <Compile Include="Cameras\KxCamFrame.cs" />
