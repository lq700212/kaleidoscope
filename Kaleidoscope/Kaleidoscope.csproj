<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{11111111-2222-3333-4444-555555555555}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Kaleidoscope</RootNamespace>
    <AssemblyName>Kaleidoscope</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- 推理协议适配层（Infer，V2.4.0）：OpenAI/Anthropic/Ollama/自研契约/JEV Decisions
         五协议 HTTP 调用——BCL HttpClient（System.Net.Http），零第三方依赖 -->
    <Reference Include="System.Net.Http" />
    <!-- ADO.NET 基类（SQLiteConnection/Command 的继承基座，Stores 落库引擎） -->
    <Reference Include="System.Data" />
    <!-- 串口扫码枪（ScannerService） -->
    <Reference Include="System.IO.Ports" />
    <!-- 图片存储（ImageStore 用 Bitmap/Image） -->
    <Reference Include="System.Drawing" />
    <!-- WMI 串口识别（SerialPortHelper / 扫码枪自动识别，System.Management） -->
    <Reference Include="System.Management" />
    <!-- 配置持久化（Configuration\ConfigSerializer：DataContractJsonSerializer 序列化 DeviceHubConfig，
         net472 内置零第三方依赖；JsonReaderWriterFactory 返回 XmlDictionaryWriter 需 System.Xml） -->
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <!-- 本地引用的第三方库（libs 目录，离线可编译）：
         NModbus：Modbus 主站/从站（CreateMaster / CreateSlaveNetwork / CreateRtuMaster）
         NModbus.Serial：RTU 主站（factory.CreateRtuMaster(SerialPort)），气压表 RS485 用 -->
    <Reference Include="NModbus4">
      <HintPath>libs\NModbus4.dll</HintPath>
      <!-- NModbus4（命名空间 Modbus.Device，与上方 NModbus 3.0.83 命名空间不同可并存）；
           2026-10-25 随 VibFeederController 自 HJVision 生产工程下沉引入
           （HJVision 引 00_ExeBuild\NModbus4.dll，本文件为同一拷贝） -->
    </Reference>
    <Reference Include="NModbus">
      <HintPath>libs\NModbus.dll</HintPath>
      <!-- NuGet: NModbus 3.0.83（git 2023 fork，命名空间 NModbus，工厂方法 CreateMaster/CreateSlaveNetwork） -->
    </Reference>
    <Reference Include="NModbus.Serial">
      <HintPath>libs\NModbus.Serial.dll</HintPath>
      <!-- NuGet: NModbus.Serial 3.0.83（RTU 主站扩展，CreateRtuMaster 需引用本 dll） -->
    </Reference>
    <Reference Include="HslCommunication">
      <HintPath>libs\HslCommunication.dll</HintPath>
      <!-- 公司购买的商业 PLC 协议库 12.6.0.0（从 HJvision 项目随库迁移，V1.6.0）：
           多品牌 PLC 主站（三菱/欧姆龙/西门子/汇川）+ EtherNet/IP 扫码枪；
           授权统一在 Utils/HslAuthorization 注册，仅 Services 层引用，Models/Configuration 不依赖 -->
    </Reference>
    <!-- System.Data.SQLite 1.0.119（Stores 落库引擎用；从 HJVision 运行目录同版本迁入）。
         部署三件套：本 dll + x64\SQLite.Interop.dll + x86\SQLite.Interop.dll（libs 内同存，
         native interop 按进程位数随 exe 目录 x64/x86 子目录部署，缺则运行时报找不到 interop） -->
    <Reference Include="System.Data.SQLite">
      <HintPath>libs\System.Data.SQLite.dll</HintPath>
    </Reference>
    <!-- 三品牌工业相机 SDK 的 .NET wrapper（Cameras 相机层用；均 AMD64/MSIL-64，
         消费项目必须 64 位进程 AnyCPU+Prefer32Bit=false）。
         【运行库硬约束】wrapper 依赖机器上安装的原生运行库：海康 MVS 客户端
         （MvCameraControl.dll/MvGigEVisionIF 等）、海康 3D 运行库（Mv3dLpPlatform 等）、
         大恒 Galaxy 驱动（libGxIAPINET/DxImageProc 等）——未安装驱动时 wrapper 的
         C++/CLI 程序集 JIT 一碰即 FileNotFound，故库内"校验与 SDK 执行分离"：
         纯校验方法不引用 SDK 类型，执行方法在缺驱动时走正常错误串（Cameras 层沿用） -->
    <Reference Include="GxIAPINET">
      <HintPath>libs\GxIAPINET.dll</HintPath>
    </Reference>
    <Reference Include="MvCameraControl.Net">
      <HintPath>libs\MvCameraControl.Net.dll</HintPath>
    </Reference>
    <Reference Include="Mv3dLpNet">
      <HintPath>libs\Mv3dLpNet.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- 推理协议适配层（Infer，V2.4.0）：四视觉协议 transport + JEV Decisions 决策协议
         + 框解析（BoxParser 0~1000 归一化、无置信度红线）+ 门面（InferClient）。 -->
    <Compile Include="Infer\InferEndpoint.cs" />
    <Compile Include="Infer\IInferTransport.cs" />
