    <Compile Include="Models\BarometerData.cs" />
    <Compile Include="Models\FanData.cs" />
    <Compile Include="Models\IoStatus.cs" />
    <Compile Include="Models\IoPointDefinition.cs" />
    <Compile Include="Models\IoOutputChannelRemap.cs" />
    <Compile Include="Models\DeviceHubConfig.cs" />
    <Compile Include="Services\PlcService.cs" />
    <Compile Include="Services\KeyenceIV4Camera.cs" />
    <Compile Include="Services\ScannerService.cs" />
    <Compile Include="Services\ScannerTcpService.cs" />
    <Compile Include="Services\ImageStore.cs" />
    <Compile Include="Services\IBarometerReader.cs" />
    <Compile Include="Services\IIoController.cs" />
    <Compile Include="Services\IFanController.cs" />
    <Compile Include="Services\ModbusRtuBarometerReader.cs" />
    <Compile Include="Services\ModbusTcpIoController.cs" />
    <Compile Include="Services\FanControllerClient.cs" />
    <Compile Include="Services\ModbusTcpMasterClient.cs" />
    <Compile Include="Services\MockBarometerReader.cs" />
    <Compile Include="Services\MockIoController.cs" />
    <Compile Include="Services\MockFanController.cs" />
    <Compile Include="Services\ConnectionMonitor.cs" />
    <Compile Include="Services\DeviceHub.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
