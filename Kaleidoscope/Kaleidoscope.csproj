    <Compile Include="Utils\TcpKeepAlive.cs" />
    <Compile Include="Utils\SerialPortHelper.cs" />
    <Compile Include="Utils\IoMapBuilder.cs" />
    <Compile Include="Utils\HslAuthorization.cs" />
    <Compile Include="Models\PlcConfig.cs" />
    <Compile Include="Models\CameraConfig.cs" />
    <Compile Include="Models\ScanConfig.cs" />
    <Compile Include="Models\ImageConfig.cs" />
    <Compile Include="Models\BarometerConfig.cs" />
    <Compile Include="Models\IoConfig.cs" />
    <Compile Include="Models\FanConfig.cs" />
    <Compile Include="Models\PlcMasterConfig.cs" />
    <Compile Include="Models\MultiBrandPlcConfig.cs" />
    <Compile Include="Models\BarometerData.cs" />
    <Compile Include="Models\FanData.cs" />
    <Compile Include="Models\IoStatus.cs" />
