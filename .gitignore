# ────────── 构建产物 ──────────
bin/
obj/

# ────────── IDE / 本地状态 ──────────
.vs/
.idea/
*.user
*.suo

# ────────── 运行时数据与日志 ──────────
*.log
Logs/
Demo/Config/
Config/
# 现场配置文件可能含现场 IP 等信息，不入开源仓库（示例配置如需入库用 git add -f）
*.kcfg

# ────────── 机密（授权码）──────────
# HSL 授权文件（AES 加密存储，运行时生成在 exe 同目录，绝不入库）
hsl.dat

# ────────── 运行时 IP/端口记忆缓存（设备自动识别落盘，exe 同目录，绝不入库）──────────
# 送风机上次连上 IP（FanControllerClient.SaveCachedIp 落盘 FanLastIp.cache）
FanLastIp.cache
# 气压表上次连上串口（ModbusRtuBarometerReader.SaveCachedPort 落盘 BarometerPort.cache）
BarometerPort.cache

# ────────── 测试编译产物（SmokeTest.cs 编译到仓库根时的产物）──────────
/SmokeTest.exe
/SmokeTest.pdb
tests/*.exe
tests/*.pdb

# ────────── 操作系统垃圾 ──────────
Thumbs.db
Desktop.ini
.DS_Store