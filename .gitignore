# ────────── 构建产物 ──────────
bin/
obj/

# ────────── IDE / 本地状态 ──────────
.vs/
.idea/
*.user
*.suo

# ────────── 运行时数据与日志 ──────────
*.log
Logs/
Demo/Config/
Config/
# 现场配置文件可能含现场 IP 等信息，不入开源仓库（示例配置如需入库用 git add -f）
*.kcfg

# ────────── 机密（授权码）──────────
# HSL 授权码：运行时由配置编辑器/业务程序生成在 exe 同目录，绝不入库
hsl.auth

# ────────── 测试编译产物（SmokeTest.cs 编译到仓库根时的产物）──────────
/SmokeTest.exe
/SmokeTest.pdb

# ────────── 操作系统垃圾 ──────────
Thumbs.db
Desktop.ini
.DS_Store