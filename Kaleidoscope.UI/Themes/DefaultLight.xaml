<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      =========================================================================
      DefaultLight.xaml：Kaleidoscope.UI 控件的缺省浅色键板（V2.1.0 全键集）

      【干什么】库内控件/样式（ChromeStyles + ChromeDialogWindow + FreshStyles +
        ShellStyles）引用的语义键缺省值——新宿主"零配置开箱"：App.xaml 合并
        本文件 + DefaultDark 即可跑起来。

      【口径来源】Fresh/Chrome 键值取自宿主 CureStation Themes/Light.xaml 一字
        未动（G2 浅色渐变浸染口径）；Shell 族键值为按 CureStation 色系推衍的
        缺省值（CureLine 实际不合并缺省板——宿主键板同名键即契约）。宿主可
        同名覆盖换品牌色——键【名】是契约（缺键=DynamicResource 静默空白，
        现场肉眼难查），键【值】可自由换皮。

      【键名清单（契约，改动须全库回归）】
        品牌：Brush.HeaderGrad / TopbarBorder / TopbarFg
        幽灵钮：Brush.GhostBg / GhostBorder / GhostFg / GhostHoverBg /
                GhostBorderHover / GhostPressedBg
        主幽灵钮：Brush.PrimaryGhostBg / PrimaryGhostBorder / PrimaryGhostFg
        弹窗面：Brush.Fresh.WinBg / Border / CardBg / CloseHoverBg
        Fresh 按钮：Brush.Fresh.ButtonBg / ButtonHoverBg / ButtonHoverBorder /
                ButtonPressedBg / FgStrong / FgMid
        实色按钮：Brush.Fresh.Accent / AccentBorder / OnAccent / AccentHover /
                AccentPressed / Danger / DangerBorder / DangerHover /
                DangerPressed / Success / SuccessBorder / SuccessHover /
                SuccessPressed
        输入：Brush.Fresh.InputBg
        Shell 族（V2.1.0）：Brush.Shell.Fg / FgDim / PanelBg / Panel2Bg / Border /
                InputBorder / Primary / PrimaryGrad / PrimaryHover / PrimaryRing /
                RingBg / HoverBg / OnPrimary / OkGrad / OkGradHover / OkFg /
                OkRing / DimOkBg / DimWarnBg / DimNgBg / DimPriBg / NgFg /
                StatusWarnFg / WarnFg / WarnRing / GridHeaderBg / GridEmptyBg /
                GridSelBg / GridLine / GridRowAltBg / RowHoverBg / RowSelectBg /
                MenuHoverBg / SwitchOffBg / SysBtnHover / SysBtnDisabled
        Fn/Fx：Fn.ShellRadius / Fn.ShellRadiusTop / Fn.ShellMenuRadius /
                Fn.ShellTitleFontWeight、Fx.ShellPrimaryGlow / Fx.ShellPrimaryGlowHover /
                Fx.ShellMenuShadow、Fx.WinShadow
        业务壳族（V2.3.0，ProductionStatistics 反哺）：
                Brush.Shell.ThemeTrack / ThemeTrackOn / ThemeTrackBorder /
                ThemeKnob / ThemeKnobOn / ThemeMoonFg / ThemeSunFg
                Fn.ShellCardRadius、Fx.ShellCardShadow /
                Fx.ShellThemeTrackShadow / Fx.ShellThemeKnobShadow
        【Theme* 七键说明】它们是"主题开关"自身的轨道/滑块配色，开关勾选=
        深色——控件本身不随主题变色，Light/Dark 两板刻意同值；要换品牌色
        改这两板同位置即可。
      ========================================================================= -->

    <!-- 品牌 -->
    <LinearGradientBrush x:Key="Brush.HeaderGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E90FF" Offset="0"/>
        <GradientStop Color="#3AA9F7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.TopbarBorder" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TopbarFg" Color="#FFFFFF"/>
    <!-- 幽灵钮 -->
    <SolidColorBrush x:Key="Brush.GhostBg" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostBorder" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostHoverBg" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostBorderHover" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GhostPressedBg" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostBorder" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryGhostFg" Color="#1E90FF"/>
    <!-- 弹窗面 -->
    <SolidColorBrush x:Key="Brush.Fresh.WinBg" Color="#F2F7FC"/>
    <SolidColorBrush x:Key="Brush.Fresh.Border" Color="#B8D4EE"/>
    <SolidColorBrush x:Key="Brush.Fresh.CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.CloseHoverBg" Color="#E81123"/>
    <!-- Fresh 按钮 -->
    <SolidColorBrush x:Key="Brush.Fresh.ButtonBg" Color="#F5FAFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonHoverBg" Color="#E3F0FC"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonHoverBorder" Color="#8FC1EC"/>
    <SolidColorBrush x:Key="Brush.Fresh.ButtonPressedBg" Color="#D0E6F9"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgStrong" Color="#1F4E79"/>
    <SolidColorBrush x:Key="Brush.Fresh.FgMid" Color="#333333"/>
    <!-- 实色按钮 -->
    <SolidColorBrush x:Key="Brush.Fresh.Accent" Color="#1E90FF"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentBorder" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.Fresh.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentHover" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.Fresh.AccentPressed" Color="#135EA8"/>
    <SolidColorBrush x:Key="Brush.Fresh.Danger" Color="#D9534F"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerBorder" Color="#C9302C"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerHover" Color="#C9302C"/>
    <SolidColorBrush x:Key="Brush.Fresh.DangerPressed" Color="#AC2925"/>
    <SolidColorBrush x:Key="Brush.Fresh.Success" Color="#5CB85C"/>
    <SolidColorBrush x:Key="Brush.Fresh.SuccessBorder" Color="#449D44"/>
    <SolidColorBrush x:Key="Brush.Fresh.SuccessHover" Color="#449D44"/>
    <SolidColorBrush x:Key="Brush.Fresh.SuccessPressed" Color="#398439"/>
    <!-- 输入 -->
    <SolidColorBrush x:Key="Brush.Fresh.InputBg" Color="#FFFFFF"/>

    <!-- ============ Shell 族（Kx 控件样式，缺省值按浅色系推衍） ============ -->
    <SolidColorBrush x:Key="Brush.Shell.Fg" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Shell.FgDim" Color="#8A94A6"/>
    <SolidColorBrush x:Key="Brush.Shell.PanelBg" Color="#F4F8FC"/>
    <SolidColorBrush x:Key="Brush.Shell.Panel2Bg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Shell.Border" Color="#D5E2EF"/>
    <SolidColorBrush x:Key="Brush.Shell.InputBorder" Color="#B8D4EE"/>
    <SolidColorBrush x:Key="Brush.Shell.Primary" Color="#1E90FF"/>
    <LinearGradientBrush x:Key="Brush.Shell.PrimaryGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E90FF" Offset="0"/>
        <GradientStop Color="#3AA9F7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Shell.PrimaryHover" Color="#1873CC"/>
    <SolidColorBrush x:Key="Brush.Shell.PrimaryRing" Color="#331E90FF"/>
    <SolidColorBrush x:Key="Brush.Shell.RingBg" Color="#1F1E90FF"/>
    <SolidColorBrush x:Key="Brush.Shell.HoverBg" Color="#141E90FF"/>
    <SolidColorBrush x:Key="Brush.Shell.OnPrimary" Color="#FFFFFF"/>
    <DropShadowEffect x:Key="Fx.ShellPrimaryGlow" Color="#4D1E90FF" BlurRadius="6" ShadowDepth="1" Direction="90" Opacity="1"/>
    <DropShadowEffect x:Key="Fx.ShellPrimaryGlowHover" Color="#4D1E90FF" BlurRadius="9" ShadowDepth="2" Direction="90" Opacity="1"/>
    <LinearGradientBrush x:Key="Brush.Shell.OkGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5CB85C" Offset="0"/>
        <GradientStop Color="#449D44" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Shell.OkGradHover" Color="#66BB6A"/>
    <SolidColorBrush x:Key="Brush.Shell.OkFg" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Brush.Shell.OkRing" Color="#335CB85C"/>
    <SolidColorBrush x:Key="Brush.Shell.DimOkBg" Color="#EAF6EC"/>
    <SolidColorBrush x:Key="Brush.Shell.DimWarnBg" Color="#FDF4DD"/>
    <SolidColorBrush x:Key="Brush.Shell.DimNgBg" Color="#FDF0F0"/>
    <SolidColorBrush x:Key="Brush.Shell.DimPriBg" Color="#ECF2FD"/>
    <SolidColorBrush x:Key="Brush.Shell.NgFg" Color="#C0392B"/>
    <SolidColorBrush x:Key="Brush.Shell.StatusWarnFg" Color="#8A5A00"/>
    <SolidColorBrush x:Key="Brush.Shell.WarnFg" Color="#B45309"/>
    <SolidColorBrush x:Key="Brush.Shell.WarnRing" Color="#33B45309"/>
    <SolidColorBrush x:Key="Brush.Shell.GridHeaderBg" Color="#EDF4FA"/>
    <SolidColorBrush x:Key="Brush.Shell.GridEmptyBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Shell.GridSelBg" Color="#1E90FF"/>
    <SolidColorBrush x:Key="Brush.Shell.GridLine" Color="#D8E4F0"/>
    <SolidColorBrush x:Key="Brush.Shell.GridRowAltBg" Color="#F7FAFD"/>
    <SolidColorBrush x:Key="Brush.Shell.RowHoverBg" Color="#EFF6FC"/>
    <SolidColorBrush x:Key="Brush.Shell.RowSelectBg" Color="#E1EFFA"/>
    <SolidColorBrush x:Key="Brush.Shell.MenuHoverBg" Color="#141E90FF"/>
    <SolidColorBrush x:Key="Brush.Shell.SwitchOffBg" Color="#D9E4EF"/>
    <SolidColorBrush x:Key="Brush.Shell.SysBtnHover" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Shell.SysBtnDisabled" Color="#A0FFFFFF"/>
    <!-- Fn/Fx -->
    <CornerRadius x:Key="Fn.ShellRadius">10</CornerRadius>
    <CornerRadius x:Key="Fn.ShellRadiusTop">10,10,0,0</CornerRadius>
    <!-- 底缘圆角【V2.3.1】：页签带/底栏等内容块贴容器下缘时用，与 ShellRadiusTop 成对
         （口径同 ShellRadius=10；宿主 ProductionStatistics 主窗内容块圆角化首次使用） -->
    <CornerRadius x:Key="Fn.ShellRadiusBottom">0,0,10,10</CornerRadius>
    <CornerRadius x:Key="Fn.ShellMenuRadius">10</CornerRadius>
    <FontWeight x:Key="Fn.ShellTitleFontWeight">SemiBold</FontWeight>
    <DropShadowEffect x:Key="Fx.ShellMenuShadow" Color="#2E5050A0" BlurRadius="12" ShadowDepth="4" Opacity="1"/>

    <!-- ============ 业务壳族（V2.3.0） ============ -->
    <!-- 主题开关：两板同值（开关不随主题变色），口径=ProductionStatistics -->
    <SolidColorBrush x:Key="Brush.Shell.ThemeTrack" Color="#252532"/>
    <SolidColorBrush x:Key="Brush.Shell.ThemeTrackBorder" Color="#32303E"/>
    <SolidColorBrush x:Key="Brush.Shell.ThemeTrackOn" Color="#1D3557"/>
    <SolidColorBrush x:Key="Brush.Shell.ThemeKnob" Color="#4A495E"/>
    <SolidColorBrush x:Key="Brush.Shell.ThemeKnobOn" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.Shell.ThemeMoonFg" Color="#CFD8E8"/>
    <SolidColorBrush x:Key="Brush.Shell.ThemeSunFg" Color="#06121F"/>
    <DropShadowEffect x:Key="Fx.ShellThemeTrackShadow" Color="#000000" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.55"/>
    <DropShadowEffect x:Key="Fx.ShellThemeKnobShadow" Color="#000000" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.6"/>
    <!-- 卡片：圆角 18 / 浅色低透明度投影 -->
    <CornerRadius x:Key="Fn.ShellCardRadius">18</CornerRadius>
    <DropShadowEffect x:Key="Fx.ShellCardShadow" Color="#182D55" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.10"/>
</ResourceDictionary>
